{
  "expo": {
    "name": "SVR Method",
    "slug": "svr-method",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "svrmethod",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "bundleIdentifier": "com.svrmethod.demo",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": ["pt-BR"]
      }
    },
    "android": {
      "package": "com.svrmethod.demo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#020202"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        { "fonts": ["./assets/brand/Montserrat-Regular.ttf", "./assets/brand/Montserrat-Medium.ttf", "./assets/brand/Montserrat-SemiBold.ttf", "./assets/brand/Montserrat-Bold.ttf", "./assets/brand/Montserrat-ExtraBold.ttf"] }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020202",
          "image": "./assets/brand/svr-logo-transparent.png",
          "imageWidth": 240
        }
      ]
    ],
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
