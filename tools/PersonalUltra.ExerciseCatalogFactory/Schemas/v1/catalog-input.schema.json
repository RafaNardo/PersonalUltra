{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalultra.local/schemas/exercise-catalog-factory/v1/catalog-input.schema.json",
  "title": "Exercise Catalog Factory input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "externalKey": { "type": ["string", "null"], "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "primaryMuscleGroup": { "type": ["string", "null"] },
          "equipment": { "type": ["string", "null"] },
          "instructionsHint": { "type": ["string", "null"] },
          "visualHint": { "type": ["string", "null"] },
          "lockedFields": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
